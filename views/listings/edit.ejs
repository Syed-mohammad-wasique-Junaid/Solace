<% layout('/layouts/boilerplate.ejs') -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Edit your listing</h3>
        <form method="post" action="/listings/<%= editlisting._id%>?_method=PUT">
            <div class="mb-3">
                <lable for="title" class="form-label">title</lable>
                <input name="listing[title]" value="<%= editlisting.title %>" 
                type="text" class="form-control">
            </div>
            <div class="mb-3">
                <lable for="description" class="form-label">Description</lable>
                <textarea name="listing[description]"  class="form-control"><%= editlisting.description %></textarea>
            </div>
            <div class="mb-3">
                <lable for="image" class="form-label">Image</lable>
                <input name="listing[image][url]" value="<%= editlisting.image.url %>" 
                type="text" class="form-control">
            </div>
            <div class="row">
                <div class="mb-3 col-md-4">
                    <lable for="price" class="form-label">Price</lable>
                    <input name="listing[price]" value="<%= editlisting.price %>" 
                    type="number" class="form-control">
                </div>
                <div class="mb-3 col-md-8">
                    <lable for="location" class="form-label">Location</lable>
                    <input name="listing[location]" value="<%= editlisting.location %>" 
                    type="text" class="form-control">
                </div>
            </div>
            <div class="mb-3">
                <lable for="country" class="form-label">Country</lable>
                <input name="listing[country]" value="<%= editlisting.country %>" 
                type="text" class="form-control">
            </div>
            <button class="btn  btn-dark edit-btn mt-3">Edit</button>
        </form>
    </div>
</div>