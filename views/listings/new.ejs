<% layout('/layouts/boilerplate.ejs') -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3>Create a new listing</h3>
        <form method="post" action="/listings">
            <div class="mb-3">
                <lable for="title" class="form-label">title</lable>
                <input name="listing[title]" 
                placeholder="Add title" 
                type="text" class="form-control">
            </div>
            <div class="mb-3">
                <lable for="description" class="form-label">description</lable>
                <textarea name="listing[description]" 
                class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <lable for="image" class="form-label">Image Link</lable>
                <input name="listing[image][url]" 
                placeholder="enter image url" type="text" class="form-control">
            </div>
            <div class="mb-3">
                <lable for="price" class="form-label">price</lable>
                <input name="listing[price]" placeholder="enter price" 
                type="number" class="form-control">
            </div>
            <div class="row">
                <div class="mb-3 col-md-4">
                    <lable for="location" class="form-label">Location</lable>
                    <input name="listing[location]" placeholder="enter location" 
                    type="text" class="form-control">
                </div>
                <div class="mb-3 col-md-8">
                    <lable for="country" class="form-label">Country</lable>
                    <input name="listing[country]" placeholder="enter country" 
                    type="text" class="form-control">
                </div>
            </div>
            <button class="btn btn-dark add-btn mt-3">Add</button>
        </form>
    </div>
</div>
